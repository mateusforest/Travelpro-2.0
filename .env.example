# Local server. Node.js 24 or newer; run npm install once.
HOST=127.0.0.1
PORT=4173
PUBLIC_ORIGIN=http://127.0.0.1:4173
# SQLite fallback only (when all three Supabase variables are empty).
# DATA_DIR defaults to ./data next to server.mjs.
# DATA_DIR=C:/TravelProData
# MASTER_KEY: optional 64 hexadecimal characters. Keep a backup.
# When omitted, data/master.key is created once. Never delete it.
MASTER_KEY=

# Optional global COS provider. Prefer per-agency settings in Integrations.
OPENAI_API_KEY=
OPENAI_MODEL=

# Password-recovery mail gateway (documented JSON contract in BACKEND.md).
RESET_EMAIL_URL=
RESET_EMAIL_KEY=

# Supabase: fill all three values to use the same backend locally and on Vercel.
# The service role key stays on the server; never put it in dist/ or commit .env.
# On Vercel set TRAVELPRO_PUBLIC_URL=https://www.usetravelpro.com.
TRAVELPRO_PUBLIC_URL=http://127.0.0.1:4173
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# Optional: 64 hexadecimal characters, needed only to store integration secrets.
# Keep the same value across deployments. Not required for login.
TRAVELPRO_ENCRYPTION_KEY=

# Granatum: private API token. Server only; never use NEXT_PUBLIC_.
# Connection and agency binding will be configured by the integration.
GRANATUM_API_TOKEN=
